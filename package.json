{
  "name": "intent-layer",
  "version": "0.0.1",
  "description": "Deterministic click-to-source editing for React and Tailwind projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "intent-layer": "dist/cli.js"
  },
  "exports": {
    "./vite": "./dist/vite.js",
    "./mcp": "./dist/mcp.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fharena/INTENT_LAYER.git"
  },
  "bugs": {
    "url": "https://github.com/Fharena/INTENT_LAYER/issues"
  },
  "homepage": "https://github.com/Fharena/INTENT_LAYER#readme",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "README_KR.md",
    "DEMO_WALKTHROUGH_EN.md",
    "DEMO_WALKTHROUGH_KR.md",
    "FAILURE_MODES_EN.md",
    "FAILURE_MODES_KR.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:package && npm run build:demo",
    "build:package": "node scripts/build-package.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:package && playwright test",
    "test:mcp-package": "node scripts/smoke-mcp-package.mjs",
    "benchmark:mcp": "tsx scripts/benchmark-mcp.ts",
    "eval:product-ab": "tsx scripts/summarize-product-ab.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:mcp-package && npm run test:e2e && npm run eval && npm run eval:product-ab",
    "prepack": "npm run build:package",
    "intent": "tsx src/intent/cli.ts",
    "intent:init": "tsx src/intent/cli.ts init",
    "intent:doctor": "tsx src/intent/cli.ts doctor",
    "intent:dev": "tsx src/intent/cli.ts dev",
    "intent:scan": "tsx src/intent/cli.ts scan",
    "intent:check": "tsx src/intent/cli.ts check",
    "intent:diff": "tsx src/intent/cli.ts diff",
    "intent:apply": "tsx src/intent/cli.ts apply",
    "intent:mcp": "tsx src/intent/cli.ts mcp",
    "intent:agent-context": "tsx src/intent/cli.ts agent-context",
    "intent:agent-task": "tsx src/intent/cli.ts agent-task",
    "intent:agent-queue": "tsx src/intent/cli.ts agent-queue",
    "intent:agent-claim": "tsx src/intent/cli.ts agent-claim",
    "intent:agent-fail": "tsx src/intent/cli.ts agent-fail",
    "intent:agent-launch": "tsx src/intent/cli.ts agent-launch",
    "intent:agent-result": "tsx src/intent/cli.ts agent-result",
    "generate:ai-corpus": "tsx scripts/generate-ai-corpus.ts",
    "analyze:classnames": "tsx scripts/analyze-classnames.ts fixtures/corpus src --out reports/performance/corpus-audit.json",
    "analyze:ai-corpus": "tsx scripts/analyze-classnames.ts fixtures/ai-generated --out reports/performance/ai-corpus-audit.json",
    "import:external-corpus": "tsx scripts/import-external-corpus.ts",
    "analyze:external-corpus": "tsx scripts/import-external-corpus.ts --analyze-only",
    "eval": "tsx scripts/evaluate-spike.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.6"
  }
}
